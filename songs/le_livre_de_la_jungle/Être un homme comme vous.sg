\selectlanguage{french}
\songcolumns{2}
\beginsong{Être un homme comme vous}
  [by={José Bartel et Jean Stout}, album={Le Livre de la jungle}]

  \beginverse*
    \textit{Intro}
    \[Cm]Dou-bi-dou dédé doudoubidou dédé\[G]déyy
    \[G]doudeyda dou de douday dé you dou \[Cm]dou.
    \[G]Skay bidoudoubi dou… « pluuuuuuuutt trompette »
  \endverse

  \beginverse
    \[Cm]Je suis le roi de la danse, oh !
    La jungle est à mes \[G]pieds
    \[G7]De la puissance j'suis au plus haut
    Et pourtant j'dois vous en\[Cm]vier
    \[Cm]Je voudrais devenir un homme
    Ce serait merveil\[G]leux
    \[G]Vivre pareil aux autres hommes
    Loin des singes ennu\[Cm]yeux…
  \endverse

  \beginchorus
    \[B&]Oh ! \[E&]Dou-bi-dou
    J'voudrais marcher comme \[C7]vous
    Et parler comme \[F7]vous
    Faire comme \[B&7]vous
    \[E&]Tout \[B&7]
    Un \[E&]singe comme moi
    Pourrait je \[C7]l'crois
    \[F7]Être parfois
    Bien plus hu\[B&7]main
    \[E&]Qu'vous !
  \endchorus

  \beginverse*
    \textit{Instrumental}
    \[E&] \[C7] \[F7] \[B&7] \[E&] \[B&7]
  \endverse

  \beginverse
    \[Cm]Pourtant, crois-moi bien qu'j'suis pas dupe
    Si j'marchande avec \[G]vous
    \[G7]C'est que je désire le moyen d'être un homme
    Un point c'est \[Cm]tout
    \[Cm]Dis-moi le secret pour être un homme
    Est-ce vraiment si mysté\[G]rieux
    \[G7]Pour moi faire éclore la grande fleur rouge
    Ce serait merveil\[Cm]leux
  \endverse

  \beginverse*
    \textit{Instrumental}
    \[B&] \[E&] \[C7] \[F7] \[B&7] \[E&] \[B&7]
    \[C7] \[F7] \[B&7] \[E&]
  \endverse

