\selectlanguage{french}
\songcolumns{2}
\beginsong{Le matou revient}
  [by={Steve Waring}]

  \musicnote{Sur les couplets, on peut gratter deux fois les cordes graves
  pour les accords La mineur, Sol et Fa.}

  \beginverse
    \[Am]Tompson, le \[G]vieux fermier, a \[F]beaucoup d'en\[E]nuis.
    \[Am]Il n'arrive pas à \[G]se débarrasser de \[F]son vieux gros chat \[E]gris.
    \[Am]Pour mettre à la porte \[G]son chat, il a \[F]tenté n'importe \[E]quoi.
    \[Am]Il l'a même posté au \[G]Canada et lui a \[F]dit « Tu resteras \[E]là ! »
  \endverse

  \beginchorus
    \[Am]Mais le matou \[G]revient le \[F]jour sui\[E]vant,
    \[Am]Le matou \[G]revient, il \[F]est toujours vi\[E]vant.
  \endchorus

  \beginverse
    \[Am]Tompson paie un \[G]petit gars pour \[F]assassiner le \[E]chat.
    \[Am]L'enfant part à la \[G]pêche, \[F]l'animal dans les \[E]bras.
    \[Am]Au milieu de la \[G]rivière, le \[F]canot a cou\[E]lé.
    \[Am]Le fermier apprend \[G]que l'enfant \[F]s'est noyééééééé\[E]é.
  \endverse

  \beginverse
    \[Am]Le voisin de \[G]Tompson com\[F]mence à s'éner\[E]ver,
    \[Am]Il prend sa cara\[G]bine et la \[F]bourre de T.N.\[E]T.
    \[Am]Le fusil \[G]éclate, la \[F]ville est affo\[E]lée,
    \[Am]Une pluie de \[G]petits morceaux \[F]d'homme vient de tom\[E]ber.
  \endverse

  \beginverse
    \[Am]Le fermier décou\[G]ragé envoie son \[F]chat chez le bou\[E]cher
    \[Am]Pour qu'il \[G]en fasse du \[F]hachis Parmen\[E]tier.
    \[Am]Le chat \[G]hurle et dispa\[F]raît dans la ma\[E]chine.
    \[Am]« De la viande poi\[G]lue » est affi\[F]ché sur la vi\[E]trine.
  \endverse

  \beginverse
    \[Am]Un fou \[G]s'engage à \[F]partir en bal\[E]lon
    \[Am]Pour aller \[G]dans la lune \[F]déposer le cha\[E]ton.
    \[Am]Au cours du \[G]voyage, le \[F]ballon a cre\[E]vé.
    \[Am]À l'autre \[G]bout du monde, \[F]un cadavre est retrou\[E]vé.
  \endverse

  \beginverse
    \[Am]Cette fois-ci, \[G]on envoie \[F]le chat au Cap Kenne\[E]dy.
    \[Am]C'est dans une fusée \[G]à trois étages \[F]qu'il est par\[E]ti.
    \[Am]Le fermier \[G]saute de joie, car \[F]il n'a plus de sou\[E]cis.
    \[Am]Le lendemain \[G]matin --- on \[F]l'appelle de Mia\[E]mi…
  \endverse
\endsong
