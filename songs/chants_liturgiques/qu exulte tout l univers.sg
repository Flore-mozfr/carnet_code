\selectlanguage{french}
\songcolumns{2}
\beginsong{Qu'exulte tout l'univers}
  []

  \beginverse*
    Intro : \[D] \[E] \[A] \[E] \[A]
  \endverse

  \beginchorus
    \[A]Qu'exulte tout l'univers
    Que soit chanté en tout \[E]lieux,
    \[F#m]La puissance \[D]de \[E]Dieu
    Dans \[A]une même allégresse
    Terre et cieux dansent de \[E]joie
    \[D]Chantent Al\[E]lelu\[A]ia.
  \endchorus

  \beginverse
    \[C#]Par amour des \[Fm]pécheurs,
    \[C#]La lumière \[D]est venue.
    \[E]Elle a changé les \[F#m]cœurs
    \[D]De tous ceux qui l'ont recon\[E]nue.
  \endverse

  \beginverse
    \[C#]Vous étiez dans la \[Fm]nuit,
    \[C#]Maintenant jubi\[D]lez.
    \[E]Dieu vous donne la \[F#m]vie,
    \[D]Parmi nous il est incar\[E]né.
  \endverse

  \beginverse
    \[C#]Que chacun recon\[F#m]naisse,
    \[C#]Jésus est notre \[D]roi
    \[E]Rejetons nos tris\[F#m]tesses
    Pour \[D]une éternité de \[E]joie.
  \endverse

  \beginverse*
    Pont : \[A] \[E] \[F#m] \[D] \[E]
  \endverse
\endsong
