\selectlanguage{french}
\songcolumns{2}
\beginsong{Qu'exulte tout l'univers}
  []

  \beginverse*
    Intro : \[D] \[E] \[A] \[E] \[A]
  \endverse

  \beginchorus
    \[A]Qu'exulte tout l'univers
    Que soit chanté en tout \[E]lieux,
    \[F#m]La puissance \[D]de \[E]Dieu
    Dans \[A]une même allégresse
    Terre et cieux dansent de \[E]joie
    \[D]Chantent Al\[E]lelu\[A]ia.
  \endchorus

  \beginverse
    \[C#]Par amour des \[Fm]pécheurs,
    \[C#]La lumière \[D]est venue.
    \[E]Elle a changé les \[F#m]cœurs
    \[D]De tous ceux qui l'ont recon\[E]nue.
  \endverse

  \beginverse
    \Vous étiez dans la nuit,
    \Maintenant jubilez.
    Dieu vous donne la vie,
    Parmi nous il est incarné.
  \endverse

  \beginverse
    \Que chacun reconnaisse,
    \Jésus est notre roi
    Rejetons nos tristesses
    Pour une éternité de joie.
  \endverse

  \beginverse*
    Pont : \[A] \[E] \[F#m] \[D] \[E]
  \endverse
\endsong
