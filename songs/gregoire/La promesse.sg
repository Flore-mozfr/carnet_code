\selectlanguage{french}
\songcolumns{2}
\beginsong{La Promesse}
  [by={Grégoire}]

	\beginverse
	\[Em] On était quelques\[C] âmes
	Qu\[Am]elques hommes quelques \[D]femmes rêvant de liberté
	\[Em]On n'était pas à \[C]vendre
	Ma\[Am]is on pouvait re\[D]vendre des montagnes d'am\[G]itié
	Le coeur en bandou\[Em]lière
	\[C]Et les bras grand ou\[Am]vert à tous les étra\[D]ngers
	On n'avait pas de p\[Em]eur
	\[C]On sentait la ch\[Am]aleur qu'on savait se \[B7]donner
	\endverse

	\beginverse
    \[Am]Même au fin fond du\[Em] désert
    \[D]On aidait les plus\[G] faibles à ne jamais \[Am]tomber
    Même au milieu des chim\[Em]ères
    \[C]On y croyait plus fort quand le courage ma\[B7]nquait

    \[G]Oh vous mes compagnons mes amis de je\[D]unesse
    \[Em]Quelques soit vos histoires non n'oubliez\[B7] jamais
    Qu\[G]'un beau jour nous avions fait ensemble une pro\[D]messe
    \[C]S'il n'en reste qu'un nous serons ce de\[B7]rnier
	
	\endverse

	\beginverse
	\[Em]On était plein d'ar\[C]deur
	\[Am]et on sortait vain\[D]queur de nos pauvres bl\[Em]essures
	Quand les pleurs étaient l\[C]ourd
	\[Am]on se trouvait to\[D]ujours une voix qui nous r\[G]assure
	On avait tant d'en\[Em]vie
	\[C]Qu'on voyait notre \[Am]vie comme une belle ave\[D]nture
	On n'avait pas de m\[Em]aitre
	\[C]La seule à nous so\[Am]umettre était la Mère \[B7]Nature
	
	\endverse

	\beginverse
    \[Am]Même au fin fond du \[Em]désert
    \[D]On aidait les plus\[G] faibles et quitte à y\[Am] rester
    Même au milieu des chim\[Em]ères
    \[C]On y croyait plus fort quand le courage man\[B7]quait

    \[G]Oh vous mes compagnons mes amis de je\[D]unesse
    \[Em]Quelques soient vos histoire non n'oubliez j\[B7]amais
    \[G]Qu'un beau jour nous avions fait ensemble une pr\[D]omesse
    S'\[C]il n'en reste qu'un nous serons ce der\[B7]nier
	\endverse

	\beginverse
	\[Am]Même au fin fond du dé\[Em]sert
	\[D]On aidait les plus\[G] faibles à ne jamais to\[Am]mber
	Même au milieu des chim\[Em]ères
	\[C]On y croyait plus fort quand le courage ma\[B7]nquait

	\[G]Oh vous mes compagnons mes amis de jeu\[D]nesse
	\[Em]Quelque soit mon histoire non je n'oublie j\[B7]amais
	\[G]Et aujourd'hui encore je refais la pro\[D]messe
	\[C]S'il n'en reste qu'un nous serons se d\[B7]ernier
	\[G]Oh vous mes compagnons mes amis de jeu\[D]nesse
	\[Em]Quelques soient vos histoires, ne m'oubliez j\[B7]amais
	\[G]Et si un jour je tombe faites moi cette pro\[D]messe
	\[C]S'il n'en reste qu'un vous serez ce de\[B7]rnier
	\[Am]Ce dernier,\[B7] ce dernier      \[Em]
	\endverse
\endsong
