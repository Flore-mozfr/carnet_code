\selectlanguage{french}
\songcolumns{2}
\beginsong{T'en fais pas, la vie est belle}
  [by={Traditionnel}, album={Jamboree (2021)}]

  \chorddiagram{C}
  \chorddiagram{G}
  \chorddiagram{Am}
  \chorddiagram{Em}
  \chorddiagram{F}
  \chorddiagram{Dm}

  \musicnote{Chanter à plusieurs voix}

  \beginverse*
    T'en fais \[C]pas la vie est \[G]belle
    Comme un \[Am]vol d'hiron\[Em]delles
    Qui s'en \[F]va et qui re\[C]vient
    Au prin\[Dm]temps, un beau ma\[G]tin
  \endverse

  \beginverse*
    \textit{Instrumental}
    \[G] \[Am] \[Em]
    \[F] \[C] \[Dm] \[G]
  \endverse

  \beginverse*
    \textit{Outro}
    \[C] \[G] \[Am] \[Em]
    \[F] \[C] \[Dm] \[G]
  \endverse
\endsong
