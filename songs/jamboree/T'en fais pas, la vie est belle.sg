  \beginverse
    Un beau matin et t'en fais \[C]pas la vie est \[G]belle, ohé
    \textit{(T'en fais pas la vie est belle)}
    Comme un \[Am]vol d'hiron\[Em]delles, ohé
    \textit{(Comme un vol d'hirondelles)}
    \textit{(Comme un vol d'hirondelles)}
    Qui s'en \[F]va
    \textit{(Qui s'en va et qui revient, ohé)} \[C]
    \textit{(Qui s'en va et qui revient)}
