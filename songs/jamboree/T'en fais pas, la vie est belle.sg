\selectlanguage{french}
\songcolumns{2}
\beginsong{T'en fais pas, la vie est belle}
  [by={Traditionnel}, album={Jamboree (2021)}]

  \beginverse*
    \textit{Intro}
    T'en fais \[C]pas la vie est \[G]belle
    Comme un \[Am]vol d'hiron\[Em]delles
    Qui s'en \[F]va et qui re\[C]vient
    Au prin\[Dm]temps, un beau ma\[G]tin
  \endverse

  \beginverse
    T'en fais \[C]pas la vie est \[G]belle
    Comme un \[Am]vol d'hiron\[Em]delles
    Qui s'en \[F]va et qui re\[C]vient
    Au prin\[Dm]temps, un beau ma\[G]tin
  \endverse

  \beginverse
    T'en fais \[C]pas la vie est \[G]belle
    Comme un \[Am]vol d'hiron\[Em]delles
    Qui s'en \[F]va et qui re\[C]vient
    Au prin\[Dm]temps, un beau ma\[G]tin
  \endverse

  \beginverse
    T'en fais \[C]pas la vie est \[G]belle
    \textit{(T'en fais pas la vie est belle, ohé)}
    Comme un \[Am]vol d'hiron\[Em]delles
    \textit{(Comme un vol d'hirondelles, ohé)}
    Qui s'en \[F]va et qui re\[C]vient
    \textit{(Qui s'en va et qui revient, ohé)}
    Au prin\[Dm]temps, un beau ma\[G]tin
    \textit{(Au printemps un beau matin)}
  \endverse

  \beginverse
    Un beau matin et t'en fais \[C]pas la vie est \[G]belle
    \textit{(T'en fais pas la vie est belle)}
    Comme un \[Am]vol d'hiron\[Em]delles
    \textit{(Comme un vol d'hirondelles)}
    \textit{(Comme un vol d'hirondelles)}
    Qui s'en \[F]va
    \textit{(Qui s'en va et qui revient)} \[C]
    \textit{(Qui s'en va et qui revient)}
    Au prin\[Dm]temps, un beau ma\[G]tin
  \endverse

  \beginverse
    Au printemps et t'en fais \[C]pas la vie est \[G]belle
    \textit{(T'en fais pas la vie est belle)}
    Comme un \[Am]vol d'hiron\[Em]delles
    \textit{(Comme un vol d'hirondelles)}
    \textit{(Comme un vol d'hirondelles)}
