\selectlanguage{french}
\songcolumns{2}

\beginsong{Le monsieur en chemise}
  [by={Marc Durand}]
\indextitleentry[titleidx]{Monsieur en chemise, Le}

  \chorddiagram{F}
  \chorddiagram{C}
  \chorddiagram{G}
  \chorddiagram{Am}

  \beginverse
  J'suis v\[Am]ert pomme, j’ai 6 ans
  J’vais aux scouts avec ma\[C]man
  J'veux jouer, j'veux camper, car tout ça me fait rêver
  Y a un m’sieur qui m’regarde du haut de ses 40 \[C]ans
  Qui me \[G]dit \og Mon p'tit gars t'es l'avenir du mouv'ment\fg
  \endverse

  \beginchorus
    Et ils a\[F]vaient \echo{*Clap*, *clap*!}
    \[C]Raison \echo{*Clap*, *clap*!}
    Le mon\[G]sieur, la madame en che\[C]mise
    Et ils a\[F]vaient \echo{*Clap*, *clap*!}
    \[C]Raison \echo{*Clap*, *clap*!}
    De me \[G]faire un petit \[C]peu la leçon
  \endchorus

  \beginverse
    J'suis orange, j’ai 8 ans
    Et j’ai peur sans ma maman
    J’sais rien faire, j’pleure tout le temps
    Et j’me d’mande ce qui m’attend
    Y a un m’sieur qui m’regarde du haut de ses 19 ans
    Qui me dit \og T’inquiète pas tu vas kiffer pour longtemps\fg
\endverse

  \beginverse
    Je suis bleu, j’ai 12 ans
    Et j’ai plus peur sans maman
    Entouré de copains, ils ne sont jamais bien loin
    J'ai appris, j'ai grandi, j'ai découvert la vraie vie
    Et l'monsieur qui me dit \og Tu vas voir, c'est pas fini\fg
  \endverse

  \beginverse
    Je suis rouge, j’ai 15 ans
    Et j’kiffe quand y a plus maman
    Entouré des mêmes gens qui avait quand j’avais 8 ans
    Y a un m’sieur qui m’regarde du haut de ses 25 ans
    Qui me dit \og  Mon p’tit gars t’es en train de dev’nir grand \fg
  \endverse

  \beginverse
    Je suis bleu nuit, j’suis majeur
    Je suis scout de tout mon coeur
    La nature, l'aventure, je veux croire en mon futur
    Y a un m’sieur qui me dit \og Je sais qu'tu peux y arriver\fg
    Avec l'aide d'la cordée, moi je gravis des sommets
  \endverse

  \beginverse
    Je suis vert, j’suis majeur
    Et j’pense même plus à ma mère
    À bâtir des projets, à partir à l’étranger
    Y a un m’sieur qui me dit \og Après ça c’est terminé\fg
    Je lui dis \og Sûr’ment pas a mon tour de faire rêver\fg
  \endverse

  \beginchorus
    Et maintenant \echo{*Clap*, *clap*!}
    C'est moi \echo{*Clap*, *clap*!}
    Le monsieur, la madame en chemise
    Et maintenant \echo{*Clap*, *clap*!}
    C'est moi \echo{*Clap*, *clap*!}
    Qui me permets de faire un peu la leçon
  \endchorus

  \beginverse
    Je suis violet, j'ai plus l'temps
    J'étais scout y'a bien longtemps
    J'sais chanter, froissarter et aussi discutailler
    Y a des yeux qui m’regardent moi qui suis maint'nant parent
    Qui me disent \og Rejoins-nous, toi aussi fais le mouv'ment\fg
  \endverse

  \beginchorus
    Et maintenant \echo{*Clap*, *clap*!}
    C'est moi \echo{*Clap*, *clap*!}
    Le monsieur, la madame en chemise
    Et maintenant \echo{*Clap*, *clap*!}
    C'est moi \echo{*Clap*, *clap*!}
    Qui me permets de faire un peu la leçon
  \endchorus
 
  \endsong
