\selectlanguage{french}
\songcolumns{2}
\beginsong{Que ma bouche chante ta louange}
[by={Communauté\ de\ l'Emmanuel}]

	\beginverse
	\[C]De toi, Seigneur, nous at\[F]tendons la \[C]vie,
	Que ma bouche \[F]chante ta lou\[G]an\[C]ge !
	\[C]Tu es pour nous un rem\[F]part, un ap\[C]pui,
	Que ma bouche \[F]chante ta lou\[G]an\[C]ge !
	La joie du \[F]cœur vient de \[G]toi, ô Sei\[Am]gneur,
	Que ma \[C]bouche \[F]chante ta lou\[G]an\[C]ge !
	Notre con\[F]fiance est dans \[G]ton nom très \[Am]saint !
	Que ma \[C]bouche \[F]chante ta lou\[G]an\[C]ge !
	\endverse

	\beginchorus
	Sois lou\[F]é Sei\[C]gneur, \[G]pour ta gran\[Am]deur, sois lou\[F]é pour \[C]tous tes bien\[G]faits.
	Gloire à \[F]toi Sei\[C]gneur, \[G]tu es vain\[Am]queur, ton a\[F]mour i\[C]nonde nos \[G]cœurs.
	Que ma \[C]bouche \[F]chante ta lou\[G]an\[C]ge ! 
	\endchorus

	\beginverse
	Tu viens sauver tes enfants égarés : que ma bouche chante ta louange !
	Qui dans leur cœur espèrent en ton amour : que ma bouche chante ta louange !
	Dans leur angoisse, ils ont crié vers toi : que ma bouche chante ta louange !
	Seigneur tu entends le son de leur voix : que ma bouche chante ta louange !
	\endverse

	\beginverse
	Seigneur tu as éclairé notre nuit : que ma bouche chante ta louange !
	Tu es lumière et clarté sur nos pas : que ma bouche chante ta louange !
	Je te rends grâce au milieu des nations : que ma bouche chante ta louange !
	Seigneur en tout temps je fête ton nom : que ma bouche chante ta louange !
	\endverse

\endsong
