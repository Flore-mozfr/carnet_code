\selectlanguage{french}
\songcolumns{2}
\beginsong{La strasbourgeoise}
  [by={Traditionnel}]
\indextitleentry[titleidx]{Strasbourgeoise, La}

	\beginverse
	 Petit p\[Am]apa, vo\[Am]ici la mi-c\[Am]arême,   \[Am]   
	 Car te voi\[Dm]ci dégui\[Dm]sé en sold\[Am]at.      \[Am]   
	 Petit pa\[Dm]pa, dis-\[Dm]moi si c'est pour \[Am]rire     \[Am]   
	 Ou pour faire \[E]peur aux \[E]tout-petits enf\[Am]ants
	 Ou pour faire \[E]peur aux \[E]tout-petits enf\[Am]ants     \[Am]   
	\endverse

	\beginverse
	 Non, mon enfant, je pars pour la Patrie :
	 C'est un devoir où tous les papas s'en vont.
	 Embrasse-moi, petite fille chérie,
	 Je rentrerai bien vite à la maison \rep{2}
	\endverse

	\beginverse
	 Dis-moi, maman, quelle est cette médaille,
	 Et cette lettre qu'apporte le facteur?
	 Dis-moi maman, tu pleures et tu défailles
	 Ils ont tué petit père adoré \rep{2}
	\endverse

	\beginverse
	 Oui, mon enfant, ils ont tué ton père;
	 Pleurons ensemble, car nous les haïssons.
	 Quelle guerre atroce qui fait pleurer les mères
	 Et tue les pères des petits anges blonds \rep{2}
	\endverse

	\beginverse
	 La neige tombe aux portes de la ville.
	 Là est assise une enfant de Strasbourg.
	 Elle reste là malgré le froid, la bise,
	 Elle reste là malgré le froid du jour \rep{2}
	\endverse

	\beginverse
	 Un homme passe, à la fillette donne.
	 Elle reconnaît l'uniforme allemand.
	 Elle refuse l'aumône qu'on lui donne.
	 A l'ennemi, elle dit bien fièrement \rep{2}
	\endverse

	\beginverse
	 Gardez votre or, je garde ma puissance;
	 Soldat prussien, passez votre chemin.
	 Moi, je ne suis qu'une enfant de la France.
	 A l'ennemi, je ne tends pas la main \rep{2}
	\endverse

	\beginverse
	 Tout en priant sous cette cathédrale,
	 Ma mère est morte sous ce porche écroulé,
	 Frappée à mort par l'une de vos balles,
	 Frappée à mort par l'un de vos boulets \rep{2}
	\endverse

	\beginverse
	 Mon père est mort sur vos champs de bataille,
	 Je n'ai pas vu l'ombre de son cercueil,
	 Frappé à mort par l'une de vos balles.
	 C'est la raison de ma robe de deuil \rep{2}
	\endverse

	\beginverse
	 Vous avez eu l'Alsace et la Lorraine,
	 Vous avez eu des millions d'étrangers,
	 Vous avez eu Germanie et Bohême,
	 Mais mon p'tit coeur, vous ne l'aurez jamais,
	 Mais mon p'tit coeur, lui restera français !
	\endverse

\endsong
