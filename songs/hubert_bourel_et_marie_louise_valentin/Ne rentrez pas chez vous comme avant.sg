\selectlanguage{french}
\songcolumns{2}
\beginsong{Ne rentrez pas chez vous comme avant}
  [by={Hubert Bourel et Marie-Louise Valentin}]

\beginverse*
Intro : \[B]
\endverse

\beginchorus
Ne rentrez \[Am]pas chez vous comme \[Dm]avant
Ne vivez \[G]pas chez vous comme \[C]avant\[E7]
Changez vos \[Am]cœurs, chassez vos \[Dm]peurs
\[Am]Vivez en \[E7]hommes nou\[Am]veaux
\endchorus

\beginverse
À quoi \[Am]bon les mots, si l'on ne s'en\[Dm]tend pas,
À quoi \[G]bon les phrases, si l'on n'é\[C]coute pas,\[E7]
À quoi \[Am]bon la joie, si l'on ne par\[Dm]tage pas,
À quoi \[Am]bon la \[E7]vie, si l'on n'aime \[Am]pas ?
\endverse

\beginchorus
Ne rentrez \[Am]pas chez vous comme \[Dm]avant
Ne vivez \[G]pas chez vous comme \[C]avant\[E7]
Changez vos \[Am]cœurs, chassez vos \[Dm]peurs
\[Am]Vivez en \[E7]hommes nou\[Am]veaux
\endchorus

\beginverse
Pourquoi \[Am]une chanson si l'on ne \[Dm]chante pas,
Pourquoi \[G]l'espérance si l'on \[C]n'y croit pas,\[E7]
Pourquoi \[Am]l'amitié si l'on \[Dm]n'accueille pas,
Pourquoi \[Am]dire l'a\[E7]mour si l'on n'agit \[Am]pas ?
\endverse

\beginchorus
Ne rentrez \[Am]pas chez vous comme \[Dm]avant
Ne vivez \[G]pas chez vous comme \[C]avant\[E7]
Changez vos \[Am]cœurs, chassez vos \[Dm]peurs
\[Am]Vivez en \[E7]hommes nou\[Am]veaux
\endchorus

\beginverse
Je vais \[Am]repartir, je veux \[Dm]te prier,
Je vais \[G]repartir et je veux \[C]t'écouter,\[E7]
Je vais \[Am]repartir et je veux \[Dm]te chanter,
Je vais \[Am]repar\[E7]tir, je veux t'annon\[Am]cer.
\endverse

\beginchorus
Ne rentrez \[Am]pas chez vous comme \[Dm]avant
Ne vivez \[G]pas chez vous comme \[C]avant\[E7]
Changez vos \[Am]cœurs, chassez vos \[Dm]peurs
\[Am]Vivez en \[E7]hommes nou\[Am]veaux
\endchorus

\endsong
