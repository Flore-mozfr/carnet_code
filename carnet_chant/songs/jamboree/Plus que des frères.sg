\selectlanguage{french}
\songcolumns{2}
\beginsong{Plus que des frères}
  [by={Jamboree}]

	\beginverse
	 \[Am]  On est là, g'nou au sol dans la rosée du\[F] matin
	 \[C] Bermuda, badge au col, près de nos coeurs en \[G]commun
	 \[Am] Un foulard, un symbole d'une famille de \[F]copains
	 On est tous ensem\[C]ble, faisons la forêt notre cham\[G]bre
	\endverse
	\beginverse*
	 Dans \[Fmaj7]ces allées de chênes où les loups
	 \[Am]Parfois se déchaînent comme nou\[G]s, comme nou\[G]s 
	 \[Fmaj7]Des vallées, des plaines de cailloux
	 \[Am]Unis ici, unis partou\[G]t 
	 Enfants des bois, unis \[G]par la loi
	\endverse

	\beginchorus
	 \[N.C.]On a \[Am]tous le \[G]même che\[C]min
	 Croix \[F]de bois, croix de f\[Am]er 
	 \[G]On est plus que des\[C] frères
	 On fait \[Am]tous la \[G]même pro\[C]messe
	 Et \[F]jamais on se l\[Am]aisse
	 On se re\[G]trouve quand on se \[C]perd
	 \[Am]Ohoh-oh\[G]oh-oh-oh\[C]oh-oh-oh\[F]oh
	 \[Am] On e\[G]st plus que des f\[C]rères
	\endchorus

	\beginverse
	  On est là si t'es seul pour t'aider, on tient parole
	  Le respect des aînés nous aiguille dans la boussole
	  Une épée, deux bâtons, des amis, quelques chansons
	 On est tous ensemble, aidons la nature à s'étendre
	\endverse
	\beginverse*
	 Des vallées, des plaines de cailloux
	 Unis ici, unis partout
	 Enfants des bois, unis par la loi
	\endverse

	\beginverse
	 On est plus que des frères
	\endverse
	
	\beginverse
	 \[Am]Ohoh-oh\[G]oh-oh-oh\[C]oh-oh-oh\[F]oh
	 \[Am] On e\[G]st plus que des f\[C]rères
	 \[Am]Ohoh-oh\[G]oh-oh-oh\[C]oh-oh-oh\[F]oh
	 \[Am] On e\[G]st plus que des f\[C]rères

	\endverse

\endsong
