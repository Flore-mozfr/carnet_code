\selectlanguage{french}
\songcolumns{2}
\beginsong{À nos souvenirs}
  [by={Trois\ Cafés\ Gourmands}]

	\beginverse
 	\[Am]Comment puis-je oublier
 	Ce coin de parad\[F]is?
 	Ce petit bout de \[C]terre
 	Où vit encore mon \[G]père
	\endverse

	\beginverse
    Comment pourrais-je faire
    pour me séparer d'elle?
    Oublier qu'on est frères,
    belle Corrèze charnelle,
	\endverse

	\beginverse
	Oublier ce matin
	que tu es parisien,
	Que t'as de l'eau dans le vin,
	Que tu es parti loin?
	\endverse
	
	\beginverse
    Ce n'était pas ma faute,
    On joue des fausses notes,
    On se trompe de chemin,
    et on a du chagrin.
	\endverse
	
	\beginverse
    On se joue tout un drame,
    On a des vagues à l'âme,
    Tu as du mal au coeur,
    Tu as peur du bonheur.
	\endverse
	
	\beginverse
    Acheter des tableaux,
    Et des vaches en photo,
    C'est tout c'que t'as trouvé
    Pour te la rappeler.
	\endverse
	
	\beginverse
    Vous me trouvez un peu con,
    Vous n'aimez pas ma chanson,
    Vous me croyez bizarre,
    Un peu patriotard,
	\endverse
	
	\beginverse
    Le fruit de ma réflexion
    ne touchera personne,
    Si vos pas ne résonnent
    jamais dans ma région,
	\endverse
	
	\beginverse
    C'est pire qu'une religion,
    Au-delà d'une confession,
    Je l'aime à en mourir,
    Pour le meilleur et pour le pire.
	\endverse
	\beginverse
    Et si je monte au ciel,
    Il y aura peut être Joël,
    Guillaume et Jeremy,
    et mon cousin Pedri,
    \endverse
	\beginverse
	Yoann sera en voyage,
    dans un autre pays,
    Allez, fais tes bagages,
    Viens rejoindre tes amis:
	\endverse
	
	\beginverse
    On veut du Claudie musette,
    A en perdre la tête,
    On veut un dernier chabrol,
    Un petit coup de gnôle,
	\endverse
	\beginverse
    Les yeux de nos grands-mères,
    La voix de nos grands-pères,
    L'odeur de cette terre,
    Vue sur les Monédières,
    \endverse
	\beginverse
	C'est pire qu'un testament,
	Au delà d'une confidence,
    On est des petits enfants
    de ce joli coin de France.
    \endverse
	\beginverse
	Enterrez-nous vivants,
    Bâillonnez s'il le faut,
    Mais prenez soin avant,
    De remplir notre jabot
	\endverse
	
	\beginverse
    La relève est pour toi,
    notre petit Lucas,
    On t'laisse en héritage la piste,
    Nous, on dégage.
	\endverse
	\beginverse
    Le temps nous a gâtés,
    On en a bien profité,
    On a des souvenirs en tête,
    Ce soir, faisons la fête!
	\endverse
	
	\beginverse
    Acceptez ma rengaine!
    Elle veut juste te dire : "je t'aime"
    Soyez sûrs, j'en suis fier,
    J'ai la Corrèze dans l'cathéter,
	\endverse
	\beginverse
    D'être avec vous ce soir,
    J'ai le coeur qui pétille,
    Mimi sers nous à boire,
    On a les yeux qui brillent
	\endverse
	
	\beginverse
	Am  F  C  G (3)
	 Pala pala pala ...
	
	\endverse
	
	\beginverse
    Acceptez ma rengaine!
    Elle veut juste te dire: "Je t'aime"
    Soyez sûrs, j'en suis fier,
    J'ai la Corrèze dans l'cathéter,
	\endverse
	\beginverse
    D'être avec vous ce soir,
    J'ai le coeur qui pétille,
    Mimi, sers nous à boire,
    On a les yeux qui brillent...
	\endverse


\endsong
