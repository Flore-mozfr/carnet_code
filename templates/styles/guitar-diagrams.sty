% Shared guitar fingerings. Song files only select which diagrams to display.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{guitar-diagrams}[2026/10/08 Shared guitar diagrams]
\newcommand{\DeclareGuitarDiagram}[2]{%
  \expandafter\edef\csname guitar@diagram@#1\endcsname{\noexpand\gtab{\detokenize{#1}}{\unexpanded{#2}}}%
}
\newcommand{\chorddiagram}[1]{%
  \ifcsname guitar@diagram@#1\endcsname
    \csname guitar@diagram@#1\endcsname
  \else
    \PackageError{guitar-diagrams}{Unknown chord diagram: #1}{Declare its fingering in guitar-diagrams.sty.}%
  \fi
}

